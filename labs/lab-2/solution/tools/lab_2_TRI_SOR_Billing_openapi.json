  "paths": {
    "/get_billing_record_by_id": {
      "post": {
        "summary": "TRI_TSOR_Billing_get_billing_record_by_id",
        "description": "Retrieve a single billing record by its billing record ID. Use when a specific billing record ID (format B-*) is known and the full record details are needed. Do NOT call if only an order ID is available — use get_billing_records_by_order_id_ext instead. Returns: billing_record with billing_record_id, order_id, billing_date, amount, description, status.",
        "operationId": "TRI_TSOR_Billing_get_billing_record_by_id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_billing_record_by_id_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/get_billing_record_by_id_output"
                }
              }
            }
          },
          "400": {
            "description": "The request contains invalid parameters, or they are missing."
          },
          "404": {
            "description": "The requested resource does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/get_billing_records_by_order_id_ext": {
      "post": {
        "summary": "TRI_TSOR_Billing_get_billing_records_by_order_id_ext",
        "description": "Retrieve all billing records linked to a specific order with a structured status envelope. Use when an order ID is known and the agent or workflow needs to review the billing history for that order with explicit domain error signalling (e.g. branching on result.is_error or result.error_code if the order does not exist). Do NOT call if only a customer ID is available — use a billing-by-customer tool instead. Returns: result — is_error (boolean), error_code (string, e.g. \"ORDER_NOT_FOUND\"), error_message (string), and billing_records[] (each with billing_record_id, order_id, billing_date, amount, description, status ordered oldest first / newest last by billing_date).",
        "operationId": "TRI_TSOR_Billing_get_billing_records_by_order_id_ext",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_billing_records_by_order_id_ext_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/get_billing_records_by_order_id_ext_output"
                }
              }
            }
          },
          "400": {
            "description": "The request contains invalid parameters, or they are missing."
          },
          "404": {
            "description": "The requested resource does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/update_billing_record_status_description": {
      "post": {
        "summary": "TRI_TSOR_Billing_update_billing_record_status_description",
        "description": "Update the status and human-readable description of a billing record to record the outcome of a billing dispute. Use when a billing dispute has been resolved or escalated and the record must be annotated with a new status and explanation. Do NOT call before supervisor approval is confirmed — this is a write operation; only the workflow should invoke it after the HITL gate has passed. Returns: billing_record_update_status — on success: billing_record (updated record); on domain failure (HTTP 200): is_error (boolean), error_code and error_message.",
        "operationId": "TRI_TSOR_Billing_update_billing_record_status_description",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/update_billing_record_status_description_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/update_billing_record_status_description_output"
                }
              }
            }
          },
          "400": {
            "description": "The request contains invalid parameters, or they are missing."
          },
          "404": {
            "description": "The requested resource does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
