# Trinity event — participant credentials
# ─────────────────────────────────────────────────────────────────────────────
# Fill in the five values below during "Setup & Event Credentials" (Section 1.2).
# This file is your single source of truth for all lab scripts.
#
# See: lab-guides/Setup & Event Credentials.md — Section 1.2
#      Step 1  → sorUsername, sorPassword
#      Step 2  → sorURL, wxoAPIKey, wxoServiceInstanceURL
#
# IMPORTANT: This file is protected from being overwritten by a git pull once
# you have filled it in (via .gitattributes merge=ours). Your local values are
# safe. To reset it to blank, run: git checkout labs/event.env
# ─────────────────────────────────────────────────────────────────────────────

# ── SOR credentials (from Step 1 / Jam User Management App) ──────────────────
# Your SOR user ID, e.g. usr012
sorUsername=

# Your SOR password (from the Jam User Management App)
sorPassword=

# SOR base URL — paste the value shown in the Jam User Management App as-is.
# You may include or omit the /bas suffix — scripts handle both.
# Example: https://cpd-cp4ba.apps.itz-xyz.techzone.ibm.com
sorURL=https://cpd-ibm-cp4ba.swat-dev-roks-vpc-02-464887bc828751e1b00625ca9211fbca-0000.eu-de.containers.appdomain.cloud

# ── wxO credentials (from Step 2 / wxO UI Settings) ──────────────────────────
# Your personal wxO API key — shown only once; copy it before closing the dialog.
wxoAPIKey=

# wxO service instance URL — from Settings → API details → Service instance URL.
# Example: https://api.dl.watson-orchestrate.ibm.com/instances/abc123
wxoServiceInstanceURL=
