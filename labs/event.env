# Trinity event — participant credentials
# ─────────────────────────────────────────────────────────────────────────────
# The five values below are filled in during "Setup & Event Credentials" (Section 1.1).
# This file is your single source of truth for all lab scripts.
#
# See: lab-guides/Setup & Event Credentials.md — Section 1.1
#      Run the setup script. It saves sorUsername and sorPassword here and, after you generate the
#      key with lab-guides/Generate Your wxO API Key.md, wxoAPIKey too.
#      wxoServiceInstanceURL and sorURL are pre-populated
#
# IMPORTANT: This file is protected from being overwritten by a git pull once
# you have filled it in (via .gitattributes merge=ours). Your local values are
# safe. To reset it to blank, run: git checkout labs/event.env
# ─────────────────────────────────────────────────────────────────────────────

# ── SOR credentials (retrieved by the setup script in Step 2) ────────────────
# Your SOR user ID, e.g. usr012
sorUsername=

# Your SOR password (from the Jam User Management App)
sorPassword=

# SOR base URL — paste the value shown in the Jam User Management App as-is.
# You may include or omit the /bas suffix — scripts handle both.
# Example: https://cpd-cp4ba.apps.itz-xyz.techzone.ibm.com
sorURL=https://cpd-ibm-cp4ba.swat-dev-roks-vpc-02-464887bc828751e1b00625ca9211fbca-0000.eu-de.containers.appdomain.cloud

# ── wxO credentials (key generated per lab-guides/Generate Your wxO API Key.md, saved by the setup script) ──
# Link to the guide for generating the wxO API key. The setup script shows it after it retrieves your SOR user ID.
wxoKeyGenUrl=https://github.com/IBM/ba-wxo-tech-jam/blob/main/lab-guides/Generate%20Your%20wxO%20API%20Key.md

# Your personal wxO API key — shown only once; copy it before closing the dialog.
wxoAPIKey=

# wxO service instance URL — from Settings → API details → Service instance URL.
# Example: https://api.ap-southeast-1.dl.watson-orchestrate.ibm.com/instances/abc123
wxoServiceInstanceURL=https://api.ap-southeast-1.dl.watson-orchestrate.ibm.com/instances/20261026-1716-2749-6015-fc9a426bdc39
