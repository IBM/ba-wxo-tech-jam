  "paths": {
    "/get_order_by_id": {
      "post": {
        "summary": "TRI_TSOR_Orders_get_order_by_id",
        "description": "Retrieve the full details of a specific order by its order ID. Use when an order ID (format O-*) is available and the agent needs the complete order record including all line items. Do NOT call if only a customer ID is available — use a get_orders_by_customer_id tool to list orders first, then call this for the specific order. Returns: order_id, customer_id, order_date, total, items[] (order_item_id, catalog_item_id, name, category, sub_category, price, quantity, under_warranty).",
        "operationId": "TRI_TSOR_Orders_get_order_by_id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_order_by_id_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/get_order_by_id_output"
                }
              }
            }
          },
          "400": {
            "description": "The request contains invalid parameters, or they are missing."
          },
          "404": {
            "description": "The requested resource does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/get_orders_by_customer_id_and_item_category_last_xdays": {
      "post": {
        "summary": "TRI_TSOR_Orders_get_orders_by_customer_id_and_item_category_last_xdays",
        "description": "Retrieve all orders for a customer that contain at least one item of a given category, within a relative time window. Use when the request specifies both a product category (e.g. \"laptop\", \"headset\") and a relative time window (e.g. \"last 30 days\", \"past 4 weeks\"). Do NOT call if no category filter is needed — use a category-less orders tool instead; do NOT call if an explicit start and end date are given — use get_orders_by_customer_id_and_timeframe instead. Returns: orders[] — each with order_id, customer_id, order_date, total, items[] (order_item_id, catalog_item_id, name, category, sub_category, price, quantity, under_warranty).",
        "operationId": "TRI_TSOR_Orders_get_orders_by_customer_id_and_item_category_last_xdays",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_orders_by_customer_id_and_item_category_last_xdays_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/get_orders_by_customer_id_and_item_category_last_xdays_output"
                }
              }
            }
          },
          "400": {
            "description": "The request contains invalid parameters, or they are missing."
          },
          "404": {
            "description": "The requested resource does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/update_order": {
      "post": {
        "summary": "TRI_TSOR_Orders_update_order",
        "description": "Replace one line item in an existing order with a different catalog item. Use when a customer has confirmed a replacement product and the order ID, the item to replace, and the new catalog item ID are all known. Do NOT call until the customer has explicitly confirmed the specific replacement — never call speculatively or before the catalog search result has been presented and accepted. Returns: order — updated order with the replacement reflected in items[].",
        "operationId": "TRI_TSOR_Orders_update_order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/update_order_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/update_order_output"
                }
              }
            }
          },
          "400": {
            "description": "The request contains invalid parameters, or they are missing."
          },
          "404": {
            "description": "The requested resource does not exist."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "get_order_by_id_input": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "[Required] Order ID in format O-*, e.g. O-DF340K."
          }
        },
        "description": "Input schema for get_order_by_id",
        "x-ibm-parameter-wrapper": true
      },
