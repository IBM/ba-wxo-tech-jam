        "x-ibm-parameter-wrapper": true
      },
      "get_orders_by_customer_id_and_item_category_last_xdays_input": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "[Required] Customer ID in format C-*, e.g. C-3DBZFE."
          },
          "item_category": {
            "type": "string",
            "description": "[Required] Product category to filter by, e.g. \"laptop\", \"headset\", \"mouse\"."
          },
          "number_of_days": {
            "type": "integer",
            "format": "int32",
            "description": "[Required] Number of days back from today, e.g. 28 for \"last 4 weeks\" or 30 for \"last month\"."
          }
        },
        "description": "Input schema for get_orders_by_customer_id_and_item_category_last_xdays",
        "x-ibm-parameter-wrapper": true
      },
      "get_orders_by_customer_id_and_item_category_last_xdays_output": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "description": "{ orders: order[] }",
            "items": {
              "$ref": "#/components/schemas/order"
            }
          }
        },
        "description": "Response schema for get_orders_by_customer_id_and_item_category_last_xdays",
        "x-ibm-parameter-wrapper": true
      },
      "update_order_input": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "[Required] Order ID of the order to modify, in format O-*, e.g. O-DF340K."
          },
          "order_item_id": {
            "type": "string",
            "description": "[Required] Order item ID of the line item to replace, in format OI-*, e.g. OI-TDDU12."
          },
          "catalog_item_id": {
            "type": "string",
            "description": "[Required] Catalog item ID of the replacement product selected by the customer, in format CI-*, e.g. CI-D412F4."
          }
        },
        "description": "Input schema for update_order",
        "x-ibm-parameter-wrapper": true
      },
      "update_order_output": {
        "type": "object",
