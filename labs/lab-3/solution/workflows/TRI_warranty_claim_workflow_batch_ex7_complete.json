      "nodes": {
        "tool_49a1f4": {
          "spec": {
            "kind": "tool",
            "name": "tool_49a1f4",
            "tool": "TRI_warranty_review_workflow:ceac1724-9abb-4a72-b591-92854bd6131b",
            "position": {
              "x": 20,
              "y": 277
            },
            "description": "Initiate the warranty claim document processing workflow for a product not\npurchased through the Focus Corp online shop (reseller or external purchase \u2014\nno internal order record exists). Call when the specialist's prompt indicates\nthe product was bought from a reseller, an external shop, or any source other\nthan Focus Corp, and the customer wants to file a warranty claim.\nRequired inputs: customer_id [Required], customer_name [Required],\ncustomer_tier [Required], customer_email [Required], customer_phone [Required].\nDo NOT call if under_warranty is already present in context for the product \u2014\nthat means a Focus Corp order record exists; use the knowledge base options\nlookup instead.\nReturns: nothing \u2014 the workflow owns all document collection, extraction, HITL\nreview, and outcome steps, and presents the warranty outcome directly to the\nspecialist via its own closing step.",
            "display_name": "OH2_TRI_warranty_review_workflow",
            "input_schema": {
              "type": "object",
              "required": [
                "customer_id",
                "customer_name",
                "customer_tier",
                "customer_email",
                "customer_phone",
                "document_ref",
                "user_email_id",
                "is_online_mode"
              ],
              "properties": {
                "customer_id": {
                  "in": "body",
                  "type": "string",
                  "default": "",
                  "description": "Customer ID in format C-*, e.g. C-3DBZFE"
                },
                "document_ref": {
                  "in": "body",
                  "type": "string",
                  "format": "wxo-file",
                  "default": "",
                  "description": ""
                },
                "customer_name": {
                  "in": "body",
                  "type": "string",
                  "default": "",
                  "description": "Full name of the customer, e.g. Marie Smith"
                },
                "customer_tier": {
                  "in": "body",
                  "type": "string",
                  "default": "",
                  "description": "Customer loyalty tier (Platinum, Gold, Silver, Bronze, Standard)"
                },
                "user_email_id": {
                  "in": "body",
                  "type": "string",
                  "default": "",
                  "description": ""
                },
                "customer_email": {
                  "in": "body",
                  "type": "string",
                  "default": "",
                  "description": "Customer's email address on file"
                },
                "customer_phone": {
                  "in": "body",
                  "type": "string",
                  "default": "",
                  "description": "Customer's phone number on file"
                },
                "is_online_mode": {
                  "in": "body",
                  "type": "boolean",
                  "default": "",
                  "description": ""
                }
              }
            },
            "output_schema": {
              "type": "object",
              "properties": {
                "batch_review_result": {
                  "type": "object",
                  "properties": {
                    "is_in_warranty": {
                      "type": "boolean",
                      "description": ""
                    }
                  },
                  "description": ""
                }
              }
            },
            "error_handler_config": {
              "max_retries": 0,
              "error_message": "Something went wrong while running 'OH2_TRI_warranty_review_workflow'",
              "retry_interval": 1000
            }
          },
          "input_map": {
            "spec": {
              "maps": [
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.customer_email",
                  "value_expression": "flow[\"Iterate over all documents\"].private.current_item.customer_email"
                },
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.customer_id",
                  "value_expression": "flow[\"Iterate over all documents\"].private.current_item.customer_id"
                },
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.customer_name",
                  "value_expression": "flow[\"Iterate over all documents\"].private.current_item.customer_name"
                },
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.customer_phone",
                  "value_expression": "flow[\"Iterate over all documents\"].private.current_item.customer_phone"
                },
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.customer_tier",
                  "value_expression": "flow[\"Iterate over all documents\"].private.current_item.customer_status"
                },
                {
                  "metadata": {
                    "assignmentType": "variable"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.document_ref",
                  "value_expression": "flow[\"Iterate over all documents\"][\"Fetch PDF from SOR\"].output"
                },
                {
                  "metadata": {
                    "assignmentType": "pyExpression"
                  },
                  "has_no_value": false,
                  "target_variable": "self.input.is_online_mode",
                  "value_expression": "False"
                },
                {
