    "tool_5617ca": {
      "spec": {
        "kind": "tool",
        "name": "tool_5617ca",
        "tool": "TRI_get_pending_warranty_requests:cfde8adb-d419-4078-8d96-e5f833d76125",
        "position": {
          "x": 0,
          "y": 301
        },
        "description": "Retrieve all pending warranty claim requests queued for batch processing.\n\nUse as the entry point for a batch warranty claim workflow when a list of\nunprocessed requests is needed. Do NOT call during a single-customer warranty\nlookup \u2014 use customer-scoped CRM tools instead. Does not return the warranty\ndocument itself \u2014 fetch it separately per record via TRI_fetch_baw_pdf(customer_id).\nReturns: outstanding_warranty_requests[] \u2014 each with customer_id, customer_name,\ncustomer_status, customer_email, customer_phone.\n\nUses OH2_TRI_cp4ba_keyvalue_team connection credentials (Key-Value / Team).",
        "display_name": "Get Pending Warranty Documents",
        "input_schema": {
          "type": "object",
          "properties": {}
        },
        "output_schema": {
          "type": "object",
          "required": [
            "outstanding_warranty_requests"
          ],
          "properties": {
            "outstanding_warranty_requests": {
              "type": "array",
              "items": {
                "type": "object",
                "title": "WarrantyRequestItem",
                "required": [
                  "customer_id",
                  "customer_name",
                  "customer_status",
                  "customer_email",
                  "customer_phone"
                ],
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "title": "Customer Id"
                  },
                  "customer_name": {
                    "type": "string",
                    "title": "Customer Name"
                  },
                  "customer_email": {
                    "type": "string",
                    "title": "Customer Email"
                  },
                  "customer_phone": {
                    "type": "string",
                    "title": "Customer Phone"
                  },
                  "customer_status": {
                    "type": "string",
                    "title": "Customer Status"
                  }
                }
              },
              "title": "Outstanding Warranty Requests"
            }
          }
        },
        "error_handler_config": {
          "max_retries": 0,
          "error_message": "Something went wrong while running 'Get Pending Warranty Documents'",
          "retry_interval": 1000
        }
      },
      "input_map": {
        "spec": {
          "maps": [],
          "name": "",
          "fallback_strategy": "ask_the_user"
        }
      }
    },
