        "tool_f833c0": {
          "spec": {
            "kind": "tool",
            "name": "tool_f833c0",
            "tool": "TRI_fetch_baw_pdf:5adfff35-a624-49d4-ad9d-3b3bb874af8a",
            "position": {
              "x": 580,
              "y": 1008
            },
            "description": "Fetch the warranty document PDF for a customer from the BAW SOR and return raw PDF bytes.\n\nCalls the BAW CRM service to retrieve the customer's uploaded warranty proof\ndocument (receipt or warranty card) and decodes the Base64 attachment to raw\nPDF bytes. The wxO platform automatically uploads the bytes to S3 and exposes\nthe result as a file data type in the flow.\n\nUse when: the specialist has confirmed the customer uploaded their warranty\ndocument and the workflow needs to process it through Document AI.\nDo NOT call to display the document to the user — use this tool's output\nas the document_ref input to Text Extractor, Document Classifier, or\nDocument Extractor nodes.\nReturns: raw PDF bytes.",
            "display_name": "Fetch PDF from SOR",
            "input_schema": {
              "type": "object",
              "required": [
                "customer_id"
              ],
              "properties": {
                "customer_id": {
                  "type": "string",
                  "title": "Customer Id",
                  "description": "Customer ID in format C-*, e.g. C-3DBZFE."
                }
              }
            },
            "output_schema": {
              "type": "string",
              "format": "binary"
            },
            "error_handler_config": {
              "max_retries": 0,
              "error_message": "Something went wrong while running 'Fetch PDF from SOR'",
              "retry_interval": 1000
            }
          },
          "input_map": {
            "spec": {
              "maps": [],
              "name": "",
              "fallback_strategy": "ask_the_user"
            }
          }
        },
