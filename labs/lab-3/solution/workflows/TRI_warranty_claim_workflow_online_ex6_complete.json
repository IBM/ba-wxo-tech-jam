{
  "spec": {
    "kind": "flow",
    "name": "TRI_warranty_claim_workflow_online",
    "initiators": [],
    "description": "Initiate the warranty claim document processing workflow for a product not\npurchased through the Focus Corp online shop (reseller or external purchase —\nno internal order record exists). Call when the specialist's prompt indicates\nthe product was bought from a reseller, an external shop, or any source other\nthan Focus Corp, and the customer wants to file a warranty claim.\nRequired inputs: customer_id [Required], customer_name [Required],\ncustomer_tier [Required], customer_email [Required], customer_phone [Required].\nDo NOT call if under_warranty is already present in context for the product —\nthat means a Focus Corp order record exists; use the knowledge base options\nlookup instead.\nReturns: nothing — the workflow owns all document collection, extraction, HITL\nreview, and outcome steps, and presents the warranty outcome directly to the\nspecialist via its own closing step.",
    "schedulable": false,
    "display_name": "TRI_warranty_claim_workflow_online",
    "input_schema": {
      "type": "object",
      "required": [
        "customer_id",
        "customer_name",
        "customer_email",
        "customer_phone",
        "customer_tier"
      ],
      "properties": {
        "customer_id": {
          "type": "string",
          "default": "",
          "description": "Customer ID in format C-*, e.g. C-3DBZFE"
        },
        "customer_name": {
          "type": "string",
          "default": "",
          "description": "Full name of the customer, e.g. Marie Smith"
        },
        "customer_tier": {
          "type": "string",
          "default": "",
          "description": "Customer loyalty tier (Platinum, Gold, Silver, Bronze, Standard)"
        },
        "customer_email": {
          "type": "string",
          "default": "",
          "description": "Customer's email address on file"
        },
        "customer_phone": {
          "type": "string",
          "default": "",
          "description": "Customer's phone number on file"
        }
      }
